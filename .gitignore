# ── Model binaries ────────────────────────────
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.safetensors
*.engine
**/models/v*/
**/models/*.pkl
**/checkpoints/*.pt
**/checkpoints/*.pth
**/checkpoints/models--*/
**/checkpoints/CACHEDIR.TAG

# ── Demo outputs (large binaries) ─────────────
**/Demos/output_*/
**/Demos/*.mp4
**/Demos/*.webm
**/Demos/*.avi
**/Demos/*.mov
**/Demos/*.mkv
**/detection_output/
**/generated/
**/runs/

# ── Experiment tracking ───────────────────────
mlruns/
mlartifacts/
wandb/
lightning_logs/
tensorboard/

# ── Random tools / archives ───────────────────
bfg.jar
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
!**/*.yaml

# ── Environment / secrets ─────────────────────
.env
.env.local
.env.*.local
secrets.json
credentials.json

# ── IDE / OS ──────────────────────────────────
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────
*.log

