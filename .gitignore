# ═════════════════════════════════════════════
# SAIR_Jr — .gitignore
# ═════════════════════════════════════════════

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/
**/note.ipynb

# ── Environment & secrets ─────────────────────
.env
.env.local
.env.*.local
!.env.example
secrets.json
credentials.json

# ── IDE / OS ──────────────────────────────────
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs & temp ───────────────────────────────
*.log
*.tmp
*.temp

# ── ML experiment tracking (local only) ───────
mlruns/
mlartifacts/
wandb/
lightning_logs/
tensorboard/

# ── Model binaries — students should NOT commit ─
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
*.engine
**/models/v*/
**/Demos/output_*/
detection_output/

# ── YOLO weights (root + Module 4) — re-downloadable ─
/yolov8*.pt
4_Applied Deep Learning with PyTorch/*.pt
4_Applied Deep Learning with PyTorch/**/*.pt

# ── Datasets — re-downloadable ────────────────
4_Applied Deep Learning with PyTorch/data/
4_Applied Deep Learning with PyTorch/**/data/
5_GPT from scratch/data/
5_GPT from scratch/gpt2_weights/
5_GPT from scratch/checkpoints/

# ── Dataset archives ──────────────────────────
4_Applied Deep Learning with PyTorch/coco128.zip
4_Applied Deep Learning with PyTorch/**/coco128.zip
**/*.zip
!**/coco128.yaml

# ── Demo videos (generated) ───────────────────
*.mp4
*.webm
*.avi
*.mov
*.mkv

# ── Gradio auto-generated ─────────────────────
.gradio/

# ── YOLO training runs ────────────────────────
runs/

# ── Module 5 — PDFs (keep covers only) ────────
5_GPT from scratch/Resources/*.pdf
!5_GPT from scratch/Resources/*.jpg
!5_GPT from scratch/Resources/*.png

# ── miniGPT (standalone repo) ─────────────────
miniGPT/wandb/
miniGPT/checkpoints/*.pt
!miniGPT/checkpoints/epoch_*.pt

# ── Personal scratch ──────────────────────────
personal_notes.txt
todo.txt

# ── Local databases ───────────────────────────
*.db
*.sqlite
*.sqlite3

# ── CLAUDE.md (personal agent config) ─────────
CLAUDE.md
.claude/