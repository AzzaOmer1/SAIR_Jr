*.py[cod]
*.so
.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/
**/note.ipynb

# ── Datasets (never commit — re-downloadable) ─
data/cifar-10-batches-py/
data/cifar-10-python.tar.gz
data/MNIST/
data/FashionMNIST/
data/imdb/
data/coco128/
data/cifar*/
**/data/raw/
**/datasets/coco128/
